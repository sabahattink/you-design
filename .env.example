# =============================================================================
# You Design — Environment Variables
# Copy this file to .env and fill in real values for local development.
# In production (Docker compose), values come from compose.yml env_file.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Web (apps/web — Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# Auth (active in M2)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-string

# -----------------------------------------------------------------------------
# API (apps/api — Fastify)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Collab (apps/collab — Hocuspocus, M5b multiplayer)
# -----------------------------------------------------------------------------
COLLAB_PORT=3002
NEXT_PUBLIC_COLLAB_URL=ws://localhost:3002

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local dev (compose.dev.yml exposes Postgres on host port 5434 to avoid
# clashing with any other Postgres you may have running). Production
# (compose.yml) uses the in-network 'postgres' hostname on 5432.
DATABASE_URL=postgresql://youdesign:youdesign@localhost:5434/youdesign
POSTGRES_USER=youdesign
POSTGRES_PASSWORD=youdesign
POSTGRES_DB=youdesign
# Override if 5434 is also taken: POSTGRES_HOST_PORT=5435 (matches compose.dev.yml)

# -----------------------------------------------------------------------------
# Redis / Queue
# -----------------------------------------------------------------------------
# compose.dev.yml exposes Redis on host port 6381 to avoid clashing.
REDIS_URL=redis://localhost:6381
QUEUE_CONCURRENCY=4

# -----------------------------------------------------------------------------
# LLM (BYOK — used starting M2)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Smart router defaults (M2)
LLM_DEFAULT_MODEL=claude-sonnet-4-6
LLM_FAST_MODEL=claude-haiku-4-5
LLM_VISION_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# Storage (Docker volume by default)
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# -----------------------------------------------------------------------------
# Telemetry (opt-in, default off)
# -----------------------------------------------------------------------------
TELEMETRY_ENABLED=false
